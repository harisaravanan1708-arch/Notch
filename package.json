{
  "name": "notch-dude",
  "productName": "Notch Dude",
  "version": "1.0.0",
  "description": "Notch Dude - Dynamic Island & Floating Music Notch for Windows 10 & 11",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package-win": "electron-packager . \"Notch Dude\" --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --ignore=\"(\\.zip$|dist|\\.git)\" --icon=assets/icon.ico",
    "build-installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.notchdude.app",
    "productName": "Notch Dude",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "scripts/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notch Dude",
      "uninstallDisplayName": "Notch Dude"
    }
  },
  "keywords": [
    "dynamic-island",
    "notch",
    "windows",
    "notch-dude",
    "music-notch"
  ],
  "author": "Harisaravanan",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-packager": "^17.1.2",
    "gifenc": "^1.0.3"
  },
  "dependencies": {
    "loudness": "^0.4.2"
  }
}
